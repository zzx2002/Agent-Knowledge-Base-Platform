# 通用
TZ=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=kb_admin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=knowledge-files

# Elasticsearch
ES_PASSWORD=change_me

# Qdrant
QDRANT_API_KEY=change_me

# RabbitMQ
RABBITMQ_USER=kb_user
RABBITMQ_PASSWORD=change_me

# Security
JWT_SECRET=change_me_replace_with_at_least_32_chars
JWT_ISSUER=agent-knowledge-base
TASK_CALLBACK_TOKEN=change_me_internal_callback_token

# Model
# Embedding: SiliconFlow OpenAI-compatible API. Free model ID is BAAI/bge-m3.
EMBEDDING_BACKEND=openai
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Reranker: SiliconFlow OpenAI-compatible API. Free model ID is BAAI/bge-reranker-v2-m3.
RERANKER_BACKEND=openai
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OPENAI_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# LLM
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
