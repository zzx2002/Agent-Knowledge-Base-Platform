{
  "server": {
    "name": "knowledge-mcp-server",
    "version": "1.0.0",
    "protocol": "MCP Streamable HTTP",
    "endpoint": "/mcp",
    "transport": "io.modelcontextprotocol.sdk:mcp-spring-webmvc",
    "dataAccess": "仅通过 knowledge-api REST API 访问数据，不直接连接数据库",
    "note": "本文件是 Java MCP SDK 版本适配时的工具清单对照；工具定义以 McpTools.java 实际注册为准"
  },
  "tools": [
    {
      "name": "list_knowledge_bases",
      "description": "获取当前用户有权访问的知识库列表",
      "permission": "READ",
      "enabledInFirstVersion": true,
      "restApi": "GET /api/v1/knowledge-bases",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "search_knowledge",
      "description": "在指定知识库中执行全文/语义混合检索",
      "permission": "READ",
      "enabledInFirstVersion": true,
      "restApi": "POST /api/v1/search",
      "inputSchema": {
        "type": "object",
        "properties": {
          "knowledge_base_id": { "type": "string", "description": "知识库 ID" },
          "query": { "type": "string", "description": "检索问题" },
          "top_k": { "type": "integer", "description": "返回条数", "default": 5, "minimum": 1 },
          "rerank": { "type": "boolean", "description": "是否启用重排序", "default": true }
        },
        "required": ["knowledge_base_id", "query"]
      }
    },
    {
      "name": "ask_knowledge",
      "description": "基于指定知识库进行 RAG 问答并返回答案与引用来源",
      "permission": "READ",
      "enabledInFirstVersion": true,
      "restApi": "POST /api/v1/chat",
      "inputSchema": {
        "type": "object",
        "properties": {
          "knowledge_base_id": { "type": "string", "description": "知识库 ID" },
          "question": { "type": "string", "description": "用户问题" },
          "top_k": { "type": "integer", "description": "召回条数", "default": 5, "minimum": 1 }
        },
        "required": ["knowledge_base_id", "question"]
      }
    },
    {
      "name": "get_document",
      "description": "根据文档 ID 获取文档元数据详情",
      "permission": "READ",
      "enabledInFirstVersion": true,
      "restApi": "GET /api/v1/documents/{id}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": { "type": "string", "description": "文档 ID" }
        },
        "required": ["document_id"]
      }
    },
    {
      "name": "list_documents",
      "description": "按知识库分页获取文档列表，支持关键字过滤",
      "permission": "READ",
      "enabledInFirstVersion": true,
      "restApi": "GET /api/v1/documents",
      "inputSchema": {
        "type": "object",
        "properties": {
          "knowledge_base_id": { "type": "string", "description": "知识库 ID" },
          "keyword": { "type": "string", "description": "文件名关键字（可选）" },
          "page": { "type": "integer", "description": "页码，从 1 开始", "default": 1, "minimum": 1 },
          "page_size": { "type": "integer", "description": "每页条数", "default": 20, "minimum": 1 }
        },
        "required": ["knowledge_base_id"]
      }
    },
    {
      "name": "get_document_content",
      "description": "根据文档 ID 获取解析后的文档正文内容",
      "permission": "READ",
      "enabledInFirstVersion": true,
      "restApi": "GET /api/v1/documents/{id}/content",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": { "type": "string", "description": "文档 ID" }
        },
        "required": ["document_id"]
      }
    },
    {
      "name": "upload_document",
      "description": "上传文档到指定知识库（可选能力，默认不注册）",
      "permission": "WRITE",
      "enabledInFirstVersion": false,
      "restApi": "POST /api/v1/documents/upload",
      "confirmationRequired": true,
      "note": "启用前必须具备 WRITE 权限（EDITOR/KB_ADMIN/ADMIN），并要求 confirm=true；实际上传接口可能为 multipart，需按 knowledge-api 签名校准",
      "inputSchema": {
        "type": "object",
        "properties": {
          "knowledge_base_id": { "type": "string", "description": "目标知识库 ID" },
          "file_name": { "type": "string", "description": "文件名" },
          "file_type": { "type": "string", "description": "文件扩展名，如 DOCX / PDF" },
          "file_content_base64": { "type": "string", "description": "文件内容 Base64 编码" },
          "confirm": { "type": "boolean", "description": "操作确认，必须为 true", "default": false }
        },
        "required": ["knowledge_base_id", "file_name", "file_content_base64", "confirm"]
      }
    },
    {
      "name": "get_parse_status",
      "description": "获取文档解析任务的当前状态（可选能力，默认不注册）",
      "permission": "READ",
      "enabledInFirstVersion": false,
      "restApi": "GET /api/v1/tasks/{id}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "解析任务 ID" }
        },
        "required": ["task_id"]
      }
    },
    {
      "name": "delete_document",
      "description": "删除指定文档（可选能力，默认不注册）",
      "permission": "DELETE",
      "enabledInFirstVersion": false,
      "restApi": "DELETE /api/v1/documents/{id}",
      "confirmationRequired": true,
      "note": "启用前必须具备 DELETE 权限（KB_ADMIN/ADMIN），并要求 confirm=true，同时写入操作审计日志",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": { "type": "string", "description": "文档 ID" },
          "confirm": { "type": "boolean", "description": "删除确认，必须为 true", "default": false }
        },
        "required": ["document_id", "confirm"]
      }
    }
  ]
}
